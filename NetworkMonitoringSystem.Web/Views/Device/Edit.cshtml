@model NetworkMonitoringSystem.Domain.Entities.Device
@{
    ViewData["Title"] = "Edit Device";
    var types    = ViewBag.DeviceTypes    as IEnumerable<NetworkMonitoringSystem.Domain.Entities.DeviceType>    ?? new List<NetworkMonitoringSystem.Domain.Entities.DeviceType>();
    var statuses = ViewBag.DeviceStatuses as IEnumerable<NetworkMonitoringSystem.Domain.Entities.DeviceStatus> ?? new List<NetworkMonitoringSystem.Domain.Entities.DeviceStatus>();
}

<div class="page-header mb-4">
    <div>
        <h5>Edit Device</h5>
        <p>Update configuration for <strong>@Model.Name</strong></p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Devices
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box">
                        <i class="fa-solid @(Model.DeviceType?.Icon ?? "fa-server") fa-fw"></i>
                    </div>
                    <div>
                        <h6 class="card-title">@Model.Name</h6>
                        <div style="font-size:0.72rem;color:var(--gray-400);" class="font-mono">@Model.IPAddress</div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.8rem;"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Device Name <span style="color:var(--color-danger);">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Hostname" class="form-label">Hostname</label>
                            <input asp-for="Hostname" class="form-control font-mono" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="IPAddress" class="form-label">IP Address <span style="color:var(--color-danger);">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-network-wired"></i></span>
                                <input asp-for="IPAddress" class="form-control font-mono" />
                            </div>
                            <span asp-validation-for="IPAddress" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MacAddress" class="form-label">MAC Address</label>
                            <input asp-for="MacAddress" class="form-control font-mono" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DeviceTypeId" class="form-label">Device Type</label>
                            <select asp-for="DeviceTypeId" class="form-select">
                                @foreach (var t in types)
                                {
                                    <option value="@t.Id" selected="@(t.Id == Model.DeviceTypeId ? "selected" : null)">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StatusId" class="form-label">Status</label>
                            <select asp-for="StatusId" class="form-select">
                                @foreach (var s in statuses)
                                {
                                    <option value="@s.Id" selected="@(s.Id == Model.StatusId ? "selected" : null)">@s.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Vendor" class="form-label">Vendor</label>
                            <input asp-for="Vendor" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Model" class="form-label">Model</label>
                            <input asp-for="Model" class="form-control" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label">Location</label>
                            <div class="input-group">
                                <input asp-for="Location" class="form-control" id="deviceLocation" />
                                <button class="btn btn-outline-secondary" type="button" id="btnGetLocation" title="Get GPS Location">
                                    <i class="fa-solid fa-location-crosshairs"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label">Department</label>
                            <input asp-for="Department" class="form-control" />
                        </div>
                    </div>

                    <h6 class="card-title mt-4 mb-3 border-bottom pb-2" style="font-size:0.9rem;">SNMP Telemetry Configuration</h6>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="SnmpVersion" class="form-label">SNMP Version</label>
                            <select asp-for="SnmpVersion" class="form-select">
                                <option value="v1" selected="@(Model.SnmpVersion == "v1" ? "selected" : null)">v1</option>
                                <option value="v2c" selected="@(Model.SnmpVersion == "v2c" ? "selected" : null)">v2c</option>
                                <option value="v3" selected="@(Model.SnmpVersion == "v3" ? "selected" : null)">v3</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SnmpCommunity" class="form-label">SNMP Community</label>
                            <input asp-for="SnmpCommunity" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SnmpPort" class="form-label">SNMP Port</label>
                            <input asp-for="SnmpPort" class="form-control" type="number" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('btnGetLocation').addEventListener('click', function() {
            if (navigator.geolocation) {
                var btn = this;
                var originalIcon = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
                
                navigator.geolocation.getCurrentPosition(function(position) {
                    var lat = position.coords.latitude;
                    var lon = position.coords.longitude;
                    
                    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data && data.display_name) {
                                document.getElementById('deviceLocation').value = data.display_name;
                            } else {
                                document.getElementById('deviceLocation').value = lat + ", " + lon;
                            }
                            btn.innerHTML = originalIcon;
                        })
                        .catch(err => {
                            document.getElementById('deviceLocation').value = lat + ", " + lon;
                            btn.innerHTML = originalIcon;
                        });
                }, function(error) {
                    alert("Error getting location: " + error.message);
                    btn.innerHTML = originalIcon;
                });
            } else {
                alert("Geolocation is not supported by this browser.");
            }
        });
    </script>
}
